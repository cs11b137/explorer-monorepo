{
  "name": "explorer-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run test -w protocol-explorer && npm run test -w mcp-explained && vite build",
    "start": "vite preview",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "mirror:protocol": "npm run mirror -w protocol-explorer",
    "mirror:mcp": "npm run mirror -w mcp-explained"
  },
  "dependencies": {
    "@explorer/engine": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
